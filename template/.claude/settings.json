{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run check:size)",
      "Bash(node scripts/check/*)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git config --get *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git worktree remove *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx *)",
      "Bash(gh *)",
      "Bash(curl *)",
      "WebFetch",
      "Edit(./.github/**)",
      "Edit(./.githooks/**)",
      "Edit(./scripts/**)",
      "Edit(./package.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(* --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n *)",
      "Bash(git commit * -n)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git *core.hooksPath *)",
      "Bash(git *core.hookspath *)",
      "Bash(git *core.hooksPath=*)",
      "Bash(git *core.hookspath=*)",
      "Bash(git *--unset* *core.hooksPath*)",
      "Bash(git *--unset* *core.hookspath*)",
      "Bash(git * --output*)",
      "Bash(git * --ext-diff*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)"
    ]
  }
}
