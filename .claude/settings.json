{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run check:size)",
      "Bash(node scripts/check/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git worktree remove *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx *)",
      "Bash(gh *)",
      "Bash(curl *)",
      "WebFetch",
      "Edit(./.github/**)",
      "Edit(./.githooks/**)",
      "Edit(./scripts/**)",
      "Edit(./package.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git reset --hard *)",
      "Bash(git config core.hooksPath *)",
      "Bash(rm -rf *)"
    ]
  }
}
